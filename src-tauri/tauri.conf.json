{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DaemonCore Data Recovery",
  "version": "0.1.0",
  "identifier": "com.daemoncore.datarecovery",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DAEMONCORE: DATA RECOVERY",
        "width": 1440,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "DaemonCore Enterprises",
    "shortDescription": "Read-only evidence image analysis",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    }
  }
}
